+/**
+ * PATCH: crea un Proxy stub para módulos nativos no encontrados.
+ * Esto evita que `requireNativeModule` tire cuando el native module
+ * no está disponible (e.g. Expo Go viejo en iPhone que no incluye
+ * todos los natives de SDK 57). El stub devuelve `undefined` para
+ * cualquier método sync y un Promise vacío para cualquier método
+ * async, suficiente para que librerías downstream (expo-linking,
+ * expo-asset, expo-constants) no rompan el árbol de React.
+ */
+function makeStub<T = any>(moduleName: string): T {
+  const handler: ProxyHandler<object> = {
+    get(_target, prop) {
+      // Propiedades especiales del Proxy.
+      if (prop === 'toString') return () => `[Stub:${moduleName}]`;
+      if (prop === 'addListener' || prop === 'removeListeners') {
+        return () => ({}) as any;
+      }
+      // Para métodos async (los que terminan en Async o se usan con await).
+      // Devolvemos una función que al llamarla devuelve un Promise vacío.
+      return new Proxy(() => undefined, {
+        get(_t, p) {
+          if (p === 'toString') return () => `[StubMethod:${String(prop)}]`;
+          return undefined;
+        },
+        apply() {
+          return Promise.resolve(undefined);
+        },
+      });
+    },
+  };
+  return new Proxy({}, handler) as T;
+}
+
 /**
